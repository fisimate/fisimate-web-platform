# Menentukan environment yang dipakai `src/configs/index.js`.
# Isi "dev" untuk memakai NEXT_PUBLIC_API_DEV_*; selain itu memakai NEXT_PUBLIC_API_*.
NEXT_PUBLIC_TYPE=

# Endpoint fisimate-api untuk development lokal (dipakai saat NEXT_PUBLIC_TYPE=dev).
# Contoh: http://127.0.0.1:8080 (fisimate-api default jalan di PORT 8080).
NEXT_PUBLIC_API_DEV_URL=
NEXT_PUBLIC_API_DEV_VERSION=v1

# Endpoint fisimate-api untuk production (dipakai saat NEXT_PUBLIC_TYPE != dev).
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_API_VERSION=v1
